[resource]
script = ExtResource("layout")
layout_id = &"s1_baseline"
place_label = "Composition Test"
patches = Array[ExtResource("patch")]([SubResource("patch_p_apron"), SubResource("patch_p_hall"), SubResource("patch_p_gallery"), SubResource("patch_p_exit_bay"), SubResource("patch_h_spine")])
connections = Array[ExtResource("conn")]([SubResource("conn_c_in"), SubResource("conn_c_bay"), SubResource("conn_c_gate"), SubResource("conn_c_arrive")])
triggers = Array[ExtResource("trig")]([SubResource("trig_t_crate_watch"), SubResource("trig_t_hidden"), SubResource("trig_t_plate"), SubResource("trig_t_cleared"), SubResource("trig_t_socket"), SubResource("trig_t_lifted"), SubResource("trig_t_exit")])
encounters = Array[ExtResource("enc")]([SubResource("enc_e_guard")])
breakables = Array[ExtResource("brk")]([SubResource("brk_b_crate"), SubResource("brk_b_urn")])
hit_switches = Array[ExtResource("sw")]([SubResource("sw_s_vent")])
obstacles = Array[ExtResource("obs")]([SubResource("obs_o_column"), SubResource("obs_o_plinth")])
carriables = Array[ExtResource("car")]([SubResource("car_k_seal")])
entry_point = Vector3(0, 0, -1)
end_marker = Vector3(0, 0, -38)
exit_console = Vector3(-3.5, 0, -38.5)
