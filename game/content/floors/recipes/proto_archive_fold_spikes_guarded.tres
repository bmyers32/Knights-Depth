[gd_resource type="Resource" script_class="FloorRecipe" format=3]

[ext_resource type="Script" path="res://game/gen/floor_recipe.gd" id="recipe"]
[ext_resource type="Script" path="res://game/gen/floor_piece.gd" id="piece"]
[ext_resource type="Script" path="res://game/gen/traversal_profile.gd" id="profile"]
[ext_resource type="Resource" path="res://game/content/strata/archive.tres" id="stratum"]
[ext_resource type="Resource" path="res://game/content/layouts/archive_prototype.tres" id="fallback"]
[ext_resource type="Resource" path="res://game/content/floors/pieces/archive_entry_hall.tres" id="pc_archive_entry_hall"]
[ext_resource type="Resource" path="res://game/content/floors/pieces/archive_landmark_crossing_guarded.tres" id="pc_archive_landmark_crossing_guarded"]
[ext_resource type="Resource" path="res://game/content/floors/pieces/archive_encounter_pit.tres" id="pc_archive_encounter_pit"]
[ext_resource type="Resource" path="res://game/content/floors/pieces/archive_objective_key_vault.tres" id="pc_archive_objective_key_vault"]
[ext_resource type="Resource" path="res://game/content/floors/pieces/archive_exit_landing.tres" id="pc_archive_exit_landing"]
[ext_resource type="Resource" path="res://game/content/floors/pieces/archive_traversal_spike_crossing.tres" id="pc_archive_traversal_spike_crossing"]
[ext_resource type="Resource" path="res://game/content/floors/profiles/link.tres" id="pf_link"]
[ext_resource type="Resource" path="res://game/content/floors/profiles/approach.tres" id="pf_approach"]
[ext_resource type="Resource" path="res://game/content/floors/profiles/link_turn.tres" id="pf_link_turn"]
[ext_resource type="Resource" path="res://game/content/floors/profiles/return.tres" id="pf_return"]

[resource]
script = ExtResource("recipe")
recipe_id = &"proto_archive_fold_spikes_guarded"
place_label = ""
stratum = ExtResource("stratum")
pieces = Array[ExtResource("piece")]([ExtResource("pc_archive_entry_hall"), ExtResource("pc_archive_landmark_crossing_guarded"), ExtResource("pc_archive_encounter_pit"), ExtResource("pc_archive_objective_key_vault"), ExtResource("pc_archive_exit_landing"), ExtResource("pc_archive_traversal_spike_crossing")])
profiles = Array[ExtResource("profile")]([ExtResource("pf_approach"), ExtResource("pf_link_turn"), ExtResource("pf_return"), ExtResource("pf_link")])
nodes = Array[Dictionary]([{
"key": &"entry",
"role": &"entry",
"tags": [&"open"]
}, {
"key": &"landmark",
"role": &"landmark",
"progression": &"mandatory",
"tags": [&"key_door", &"guarded"]
}, {
"key": &"hazard",
"role": &"landmark",
"progression": &"optional",
"tags": [&"spike_crossing"]}, {
"key": &"encounter",
"role": &"encounter",
"progression": &"mandatory",
"tags": [&"sealing"]
}, {
"key": &"objective",
"role": &"objective",
"progression": &"mandatory",
"tags": [&"key_vault"]

}, {
"key": &"exit",
"role": &"exit",
"progression": &"mandatory"
}])
edges = Array[Dictionary]([{
"from": &"entry",
"from_port": &"out",
"to": &"landmark",
"to_port": &"in",
"profile": &"approach"
}, {
"from": &"landmark",
"from_port": &"side",
"to": &"encounter",
"to_port": &"in",
"profile": &"link_turn"
}, {
"from": &"encounter",
"from_port": &"out",
"to": &"objective",
"to_port": &"in",
"profile": &"link_turn"
}, {
"from": &"landmark",
"from_port": &"back",
"to": &"hazard",
"to_port": &"out",
"profile": &"link"
}, {
"from": &"objective",
"from_port": &"back",
"to": &"hazard",
"to_port": &"in",
"profile": &"return",
"closes_cycle": true
}, {
"from": &"landmark",
"from_port": &"out",
"to": &"exit",
"to_port": &"in",
"profile": &"approach"
}])
flow_axis = Vector2(0, -1)
grid_cell = 2
margin = 2
extent = Rect2(-80, -160, 160, 164)
candidates_per_piece = 3
placement_budget = 300
reseed_budget = 3
fallback = ExtResource("fallback")
dependencies = Array[Dictionary]([{
"from": &"objective",
"from_port": &"lift_signal",
"to": &"landmark",
"effect": &"activate_encounter",
"target_key": &"E_GUARD"
}])
visibility = Array[Dictionary]([{
"from": &"landmark",
"from_port": &"approach",
"to": &"landmark",
"to_port": &"door_lock",
"intent": &"reveal",
"mandatory": true,
"door_port": &"out"
}, {
"from": &"landmark",
"from_port": &"approach",
"to": &"exit",
"to_port": &"pad",
"intent": &"conceal",
"mandatory": false
}, {
"from": &"landmark",
"from_port": &"at_door",
"to": &"exit",
"to_port": &"pad",
"intent": &"reveal",
"mandatory": false
}])
