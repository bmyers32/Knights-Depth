key = &"T_DEPLOY"
trigger_id = 0
kind = &"group_occupancy"
region = Rect2(-2, -25, 4, 4)
renders_as_plate = true
effects = Array[Dictionary]([{
"kind": &"complete_floor",
"target_id": -1
}])

[resource]
script = ExtResource("3_layout")
layout_id = &"ready_room"
place_label = "Ready Room"
patches = Array[ExtResource("1_patch")]([SubResource("Resource_p_arrival"), SubResource("Resource_p_neck"), SubResource("Resource_p_step_w"), SubResource("Resource_p_step_e"), SubResource("Resource_p_landing"), SubResource("Resource_p_floor"), SubResource("Resource_p_stall"), SubResource("Resource_p_floor_west"), SubResource("Resource_p_service"), SubResource("Resource_p_gate")])
triggers = Array[ExtResource("4_trig")]([SubResource("Resource_t_deploy")])
obstacles = Array[ExtResource("2_obst")]([SubResource("Resource_o_side_w"), SubResource("Resource_o_side_w_inner"), SubResource("Resource_o_side_e"), SubResource("Resource_o_side_e_inner"), SubResource("Resource_o_console_screens"), SubResource("Resource_o_console_core"), SubResource("Resource_o_console_desk"), SubResource("Resource_o_frame_w"), SubResource("Resource_o_frame_e"), SubResource("Resource_o_gate_machine_w"), SubResource("Resource_o_gate_machine_e"), SubResource("Resource_o_stall_shelf_w"), SubResource("Resource_o_stall_shelf_n"), SubResource("Resource_o_counter_s"), SubResource("Resource_o_stall_post"), SubResource("Resource_o_counter_e"), SubResource("Resource_o_rack_n"), SubResource("Resource_o_rack_s"), SubResource("Resource_o_armory_bench"), SubResource("Resource_o_crafter"), SubResource("Resource_o_craft_plinth")])
entry_point = Vector3(0, 0, 4)
end_marker = Vector3(0, 0, -23)
exit_console = Vector3(0, 0, -1.3)
